FROM python:3.9-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install -U platformio

WORKDIR /app

COPY platformio.ini .

COPY src/ ./src
COPY lib/ ./lib/
COPY include/ ./include/

RUN pio run

CMD ["pio", "run", "-t", "monitor"]